; Engine configuration file.
config_version=5

[application]

config/name="Осколки Эфира"
config/version="0.8.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
boot_splash/bg_color=Color(0.03, 0.024, 0.05, 1)
boot_splash/image="res://assets/ui/brand/splash.png"
boot_splash/fullsize=true
boot_splash/stretch_mode=1
boot_splash/use_filter=true

[autoload]

DB="*res://scripts/autoload/db.gd"
Game="*res://scripts/autoload/game.gd"
Net="*res://scripts/autoload/net.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true
window/size/mode=3

[gui]

theme/custom_font="res://fonts/Rubik.ttf"
theme/default_font_size=28

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
global_illumination/gi/use_half_resolution=true
environment/ssao/half_size=true
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=48
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
rendering_device/fallback_to_opengl3=true


[shader_globals]

cam_fade_dist={
"type": "float",
"value": 0.0
}
